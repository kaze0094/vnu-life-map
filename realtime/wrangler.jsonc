{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vnu-chill-realtime",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {"bindings": [{"name": "STUDY_ROOMS", "class_name": "ChillRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ChillRoom"]}],
  "vars": {"ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000"},
  "observability": {"enabled": false}
}
