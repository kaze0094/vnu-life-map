{
  "name": "vnu-life-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p realtime/tsconfig.json",
    "test": "vitest run",
    "realtime:dev": "wrangler dev --config realtime/wrangler.jsonc --port 8787 --ip 127.0.0.1",
    "realtime:check": "wrangler deploy --dry-run --outdir work/worker-build --config realtime/wrangler.jsonc",
    "test:realtime": "node scripts/test-chill-realtime.mjs",
    "test:chill-browser": "node scripts/test-chill-browser.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.161.0",
    "ws": "^8.23.0"
  }
}
