# Optional PUBLIC build-time settings; both must be supplied together.
# Default (leave unset): standard OpenStreetMap tiles, subject to OSM tile policy.
# Set only after choosing a provider whose terms permit your use and attribution.
# NEXT_PUBLIC_MAP_TILE_URL=https://your-approved-provider.example/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=Approved provider credit in plain text
# These values are bundled into browser JavaScript. Never put secrets here.

# Optional PUBLIC realtime origin, Preview environment only until approved.
# Missing: Study Together clearly shows "Chưa kết nối realtime".
# NEXT_PUBLIC_CHILL_REALTIME_URL=https://your-worker.your-subdomain.workers.dev
# Local development only: http://127.0.0.1:8787
